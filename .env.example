# Solana wallet that receives USDC for every paid request.
# This is YOUR wallet — paste the public address you want paid to.
# Pre-filled with the address from your Superteam talent profile setup.
SVM_PAY_TO=4oACGWGh7zeWTHqESC8yxMXpn8x2TzKodUxkQ7MarfD3

# Optional EVM payout address. Leave blank to disable EVM and accept only Solana.
EVM_PAY_TO=

# Facilitator handles payment verification + on-chain settlement.
#
# DEFAULT (testnet, no auth):    https://x402.org/facilitator
#   Works on Base Sepolia + Solana devnet. Use this for development.
#
# PRODUCTION (mainnet, paid):    https://api.cdp.coinbase.com/platform/v2/x402
#   Coinbase CDP — free first 1,000 tx/month, then $0.0001 per tx.
#   Requires CDP_API_KEY_NAME + CDP_API_KEY_PRIVATE_KEY set below.
#   Sign up at https://portal.cdp.coinbase.com  → create API key.
FACILITATOR_URL=https://x402.org/facilitator

# Required ONLY if FACILITATOR_URL points at Coinbase CDP:
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=

# Server port
PORT=4021

# Optional override of the gmem db file. If omitted, gmem auto-resolves
# under ~/.gmem/<projectHash>/memory.db — fine for a single-tenant demo.
GMEM_DB=
